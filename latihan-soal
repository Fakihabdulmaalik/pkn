  .slide-up { animation: slideUp 0.7s cubic-bezier(0.16, 1, 0.3, 1); }
  @keyframes slideUp { from { opacity: 0; transform: translateY(40px); } to { opacity: 1; transform: translateY(0); } }
  .fade-in { animation: fadeIn 0.4s ease-out; }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  .option-card { transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1); border: 2px solid #D4C9A8; background: white; cursor: pointer; }
  .option-card:hover { transform: translateY(-2px); border-color: var(--green-light); box-shadow: 0 10px 25px -5px rgba(27, 67, 50, 0.15); }
  .option-card.selected { background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%); border-color: var(--green-mid); }
  .q-btn { transition: all 0.2s; cursor: pointer; }
  .q-btn.answered { background: linear-gradient(135deg, #40916C 0%, #2D6A4F 100%); color: white; border-color: var(--green-mid); }
  .q-btn.current { background: linear-gradient(135deg, #1B4332 0%, #0A1F15 100%); color: white; transform: scale(1.1); }
  .self-btn { transition: all 0.2s; cursor: pointer; user-select: none; }
  .self-btn:hover { transform: scale(1.03); }
  .self-btn.marked-correct { background: linear-gradient(135deg, #40916C 0%, #2D6A4F 100%) !important; color: white !important; }
  .self-btn.marked-wrong { background: linear-gradient(135deg, #B91C1C 0%, #7F1D1D 100%) !important; color: white !important; }
