  ::-webkit-scrollbar-track { background: var(--cream); }
  ::-webkit-scrollbar-thumb { background: var(--green-mid); border-radius: 4px; }
  .topic-chip { display: inline-flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding: 0.75rem 1rem; background: white; border: 2px solid #D4C9A8; border-radius: 0.75rem; font-weight: 600; color: var(--green-dark); }
  .topic-chip .count { background: var(--green-dark); color: var(--cream); padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 700; }
  .progress-fill { background: linear-gradient(90deg, #1B4332 0%, #40916C 50%, #52B788 100%); }
