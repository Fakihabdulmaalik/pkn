// ============ STATE ============
let currentIdx = 0;
let answers = {};
let selfMarks = {};

document.getElementById('totalNum').textContent = questions.length;

function startQuiz() {
  document.getElementById('startScreen').classList.add('hidden');
  document.getElementById('quizScreen').classList.remove('hidden');
  render();
  renderGrid();
}

function render() {
  const q = questions[currentIdx];
  const area = document.getElementById('questionContent');
  
  document.getElementById('currentNum').textContent = currentIdx + 1;
  document.getElementById('topicBadge').textContent = q.topic;
  document.getElementById('typeBadge').textContent = q.type === 'pg' ? 'Pilihan Ganda' : q.type === 'isian' ? 'Isian Singkat' : 'Uraian';
  
  const pct = ((currentIdx + 1) / questions.length) * 100;
  document.getElementById('progressBar').style.width = `${pct}%`;
  
  document.getElementById('prevBtn').disabled = currentIdx === 0;
  if (currentIdx === questions.length - 1) {
    document.getElementById('nextBtn').classList.add('hidden');
    document.getElementById('submitBtn').classList.remove('hidden');
  } else {
    document.getElementById('nextBtn').classList.remove('hidden');
    document.getElementById('submitBtn').classList.add('hidden');
  }
  
  let html = `<div class="fade-in">
    <h2 class="text-xl md:text-2xl font-bold text-[#1B4332] mb-6 leading-snug">${currentIdx + 1}. ${q.q}</h2>`;

  if (q.type === 'pg') {
    html += `<div class="grid gap-3">`;
    q.opts.forEach((opt, i) => {
      const selected = answers[q.id] === opt ? 'selected' : '';
      html += `
        <div class="option-card p-4 rounded-xl flex items-center gap-3 ${selected}" onclick="selectOption(${q.id}, '${opt.replace(/'/g, "\\'")}', this)">
          <div class="w-8 h-8 rounded-full border-2 border-[#D4C9A8] flex items-center justify-center font-bold text-[#2D6A4F] text-sm shrink-0">${String.fromCharCode(65 + i)}</div>
          <span class="text-[#1B4332]">${opt}</span>
        </div>`;
    });
    html += `</div>`;
  } else {
    const val = answers[q.id] || '';
    const placeholder = q.type === 'esai' ? 'Tuliskan jawaban uraian Anda di sini...' : 'Ketik jawaban singkat...';
    const rows = q.type === 'esai' ? 6 : 1;
    
    html += `
      <textarea 
        oninput="answers[${q.id}] = this.value; updateGrid();" 
        rows="${rows}" 
        class="w-full p-4 border-2 border-[#D4C9A8] rounded-xl focus:border-[#40916C] focus:ring-4 focus:ring-[#74C69D]/30 outline-none transition text-lg text-[#1B4332] bg-white" 
        placeholder="${placeholder}">${val}</textarea>
      ${q.type === 'isian' ? '<p class="text-xs text-[#2D6A4F] mt-2">*Jawaban tidak peka huruf besar/kecil.</p>' : ''}
    `;
  }
  html += `</div>`;
  area.innerHTML = html;
}

function selectOption(qId, value, el) {
  answers[qId] = value;
  document.querySelectorAll('.option-card').forEach(c => c.classList.remove('selected'));
  el.classList.add('selected');
  updateGrid();
}

function changeQ(dir) {
  currentIdx += dir;
  if (currentIdx < 0) currentIdx = 0;
  if (currentIdx >= questions.length) currentIdx = questions.length - 1;
  render();
  renderGrid();
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function renderGrid() {
  const grid = document.getElementById('qGrid');
  grid.innerHTML = '';
  questions.forEach((q, i) => {
    const btn = document.createElement('button');
    btn.className = 'q-btn w-full aspect-square rounded-lg border-2 border-[#D4C9A8] font-bold text-sm flex items-center justify-center bg-white text-[#1B4332]';
    btn.textContent = i + 1;
    if (answers[q.id] !== undefined && answers[q.id] !== '') btn.classList.add('answered');
    if (i === currentIdx) btn.classList.add('current');
    btn.onclick = () => { currentIdx = i; render(); renderGrid(); };
    grid.appendChild(btn);
  });
  const answered = questions.filter(q => answers[q.id] !== undefined && answers[q.id] !== '').length;
  document.getElementById('answeredCount').textContent = answered;
}

function updateGrid() { renderGrid(); }

function submitQuiz() {
  const unanswered = questions.filter(q => answers[q.id] === undefined || answers[q.id] === '').length;
  if (unanswered > 0) {
    if (!confirm(`Masih ada ${unanswered} soal belum dijawab. Tetap lanjut melihat kunci jawaban?`)) return;
  } else {
    if (!confirm('Lihat kunci jawaban dan mulai penilaian pribadi?')) return;
  }
  
  document.getElementById('quizScreen').classList.add('hidden');
  document.getElementById('resultScreen').classList.remove('hidden');
  renderReview();
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function renderReview() {
  const area = document.getElementById('reviewArea');
  area.innerHTML = '';
  
  questions.forEach((q, idx) => {
    const userAns = answers[q.id] || '<em class="text-gray-400">Tidak dijawab</em>';
    const keyAns = Array.isArray(q.ans) ? q.ans[0] : q.ans;
    
    const card = document.createElement('div');
    card.className = 'border-2 border-[#D4C9A8] rounded-2xl p-5 bg-white';
    card.innerHTML = `
      <div class="flex items-start justify-between gap-3 mb-3 flex-wrap">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="px-3 py-1 bg-[#1B4332] text-[#F5F1E8] text-xs font-bold rounded-full">Soal ${idx + 1}</span>
          <span class="px-3 py-1 bg-[#D4C9A8] text-[#1B4332] text-xs font-bold rounded-full uppercase">${q.topic}</span>
          <span class="px-3 py-1 bg-[#74C69D] text-[#1B4332] text-xs font-bold rounded-full uppercase">${q.type === 'pg' ? 'PG' : q.type === 'isian' ? 'Isian' : 'Esai'}</span>
        </div>
      </div>
      
      <p class="text-[#1B4332] font-semibold mb-3 leading-relaxed">${q.q}</p>
      
      <div class="grid md:grid-cols-2 gap-3 mb-3">
        <div class="p-3 bg-[#E8F5E9] border-l-4 border-[#40916C] rounded-r-lg">
          <div class="text-xs text-[#2D6A4F] font-bold mb-1">JAWABAN ANDA</div>
          <div class="text-[#1B4332] text-sm">${userAns}</div>
        </div>
        <div class="p-3 bg-[#FFF8E1] border-l-4 border-[#D4AF37] rounded-r-lg">
          <div class="text-xs text-[#8B6914] font-bold mb-1">🔑 KUNCI JAWABAN</div>
          <div class="text-[#1B4332] text-sm font-semibold">${keyAns}</div>
        </div>
      </div>
      
      <div class="p-3 bg-[#F5F1E8] border-l-4 border-[#2D6A4F] rounded-r-lg mb-4">
        <div class="text-xs text-[#2D6A4F] font-bold mb-1"> PEMBAHASAN</div>
        <div class="text-[#1B4332] text-sm">${q.exp}</div>
      </div>
      
      <div class="flex gap-2">
        <button onclick="markSelf(${q.id}, 'correct', this)" class="self-btn flex-1 py-3 bg-white border-2 border-[#40916C] text-[#2D6A4F] rounded-xl font-bold hover:bg-[#E8F5E9] transition flex items-center justify-center gap-2">
          ✓ Benar
        </button>
        <button onclick="markSelf(${q.id}, 'wrong', this)" class="self-btn flex-1 py-3 bg-white border-2 border-[#B91C1C] text-[#B91C1C] rounded-xl font-bold hover:bg-red-50 transition flex items-center justify-center gap-2">
          ✗ Salah
        </button>
      </div>
    `;
    area.appendChild(card);
  });
  
  updateScore();
}

function markSelf(qId, mark, btn) {
  selfMarks[qId] = mark;
  const parent = btn.parentElement;
  parent.querySelectorAll('.self-btn').forEach(b => {
    b.classList.remove('marked-correct', 'marked-wrong');
  });
  btn.classList.add(mark === 'correct' ? 'marked-correct' : 'marked-wrong');
  updateScore();
}

function updateScore() {
  const total = questions.length;
  const marked = Object.keys(selfMarks).length;
  const correct = Object.values(selfMarks).filter(v => v === 'correct').length;
  
  const score = marked > 0 ? Math.round((correct / marked) * 100) : 0;
  document.getElementById('finalScore').textContent = score;
  
  let msg = '';
  if (marked < total) {
    msg = `Tandai semua soal untuk skor final (${marked}/${total} sudah dinilai)`;
  } else if (score >= 90) {
    msg = '🌟 Luar Biasa! Pemahamanmu sangat baik!';
  } else if (score >= 75) {
    msg = '👍 Bagus! Terus tingkatkan!';
  } else if (score >= 60) {
    msg = '💪 Cukup baik, pelajari lagi materi yang salah.';
  } else {
    msg = '📚 Perlu belajar lebih giat. Semangat!';
  }
  document.getElementById('scoreMessage').textContent = msg;
  
  renderBreakdown();
}

function renderBreakdown() {
  const topics = {};
  questions.forEach(q => {
    if (!topics[q.topic]) topics[q.topic] = { total: 0, correct: 0, marked: 0 };
    topics[q.topic].total++;
    if (selfMarks[q.id] !== undefined) {
      topics[q.topic].marked++;
      if (selfMarks[q.id] === 'correct') topics[q.topic].correct++;
    }
  });
  
  const area = document.getElementById('topicBreakdown');
  area.innerHTML = '';
  
  Object.entries(topics).forEach(([topic, data]) => {
    const pct = data.marked > 0 ? Math.round((data.correct / data.marked) * 100) : 0;
    const barWidth = data.marked > 0 ? (data.correct / data.marked) * 100 : 0;
    
    const row = document.createElement('div');
    row.className = 'bg-white p-4 rounded-xl border border-[#D4C9A8]';
    row.innerHTML = `
      <div class="flex justify-between items-center mb-2">
        <div class="font-bold text-[#1B4332]">${topic}</div>
        <div class="text-sm font-semibold text-[#2D6A4F]">${data.correct}/${data.marked} (${pct}%)</div>
      </div>
      <div class="h-2 bg-[#D4C9A8] rounded-full overflow-hidden">
        <div class="h-full progress-fill transition-all duration-500" style="width: ${barWidth}%"></div>
      </div>
    `;
    area.appendChild(row);
  });
}
</script>
