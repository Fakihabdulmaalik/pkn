<title>Latihan Pendidikan Pancasila - Kelas 9</title>
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    --green-dark: #1B4332;
    --green-mid: #2D6A4F;
    --green-light: #40916C;
    --green-bright: #52B788;
    --green-pale: #74C69D;
    --cream: #F5F1E8;
    --cream-dark: #E8DFC8;
    --dark: #0A1F15;
  }
  * { font-family: 'Plus Jakarta Sans', sans-serif; }
  h1, h2, h3, .serif { font-family: 'Playfair Display', serif; }
  body {
    background: linear-gradient(135deg, #F5F1E8 0%, #E8DFC8 100%);
    min-height: 100vh;
    color: var(--dark);
  }
  /* Pattern botanical subtle */
  .botanical-pattern {
    background-image: 
      radial-gradient(circle at 10% 20%, rgba(27, 67, 50, 0.04) 0%, transparent 40%),
      radial-gradient(circle at 90% 80%, rgba(82, 183, 136, 0.06) 0%, transparent 40%),
      repeating-linear-gradient(45deg, transparent, transparent 40px, rgba(27, 67, 50, 0.02) 40px, rgba(27, 67, 50, 0.02) 80px);
  }
  .green-gradient { background: linear-gradient(135deg, #1B4332 0%, #2D6A4F 100%); }
  .green-gradient-light { background: linear-gradient(135deg, #40916C 0%, #52B788 100%); }
  .glass {
    background: rgba(245, 241, 232, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(27, 67, 50, 0.1);
  }
  .glass-white {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(20px);
  }
  .slide-up { animation: slideUp 0.7s cubic-bezier(0.16, 1, 0.3, 1); }
  @keyframes slideUp { from { opacity: 0; transform: translateY(40px); } to { opacity: 1; transform: translateY(0); } }
  .fade-in { animation: fadeIn 0.4s ease-out; }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  
  /* Option cards */
  .option-card {
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    border: 2px solid #D4C9A8;
    background: white;
    cursor: pointer;
  }
  .option-card:hover {
    transform: translateY(-2px);
    border-color: var(--green-light);
    box-shadow: 0 10px 25px -5px rgba(27, 67, 50, 0.15);
  }
  .option-card.selected {
    background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
    border-color: var(--green-mid);
    box-shadow: 0 4px 15px rgba(45, 106, 79, 0.25);
  }
  
  /* Question nav buttons */
  .q-btn { transition: all 0.2s; cursor: pointer; }
  .q-btn.answered {
    background: linear-gradient(135deg, #40916C 0%, #2D6A4F 100%);
    color: white; border-color: var(--green-mid);
  }
  .q-btn.current {
    background: linear-gradient(135deg, #1B4332 0%, #0A1F15 100%);
    color: white; transform: scale(1.1);
    box-shadow: 0 4px 15px rgba(27, 67, 50, 0.4);
  }
  
  /* Self-assessment buttons */
  .self-btn { transition: all 0.2s; cursor: pointer; user-select: none; }
  .self-btn:hover { transform: scale(1.03); }
  .self-btn.marked-correct {
    background: linear-gradient(135deg, #40916C 0%, #2D6A4F 100%) !important;
    color: white !important; border-color: var(--green-mid) !important;
  }
  .self-btn.marked-wrong {
    background: linear-gradient(135deg, #B91C1C 0%, #7F1D1D 100%) !important;
    color: white !important; border-color: #7F1D1D !important;
  }
  
  /* Scrollbar */
  ::-webkit-scrollbar { width: 8px; }
  ::-webkit-scrollbar-track { background: var(--cream); }
  ::-webkit-scrollbar-thumb { background: var(--green-mid); border-radius: 4px; }
  
  /* Topic chip */
  .topic-chip {
    display: inline-flex; align-items: center; justify-content: space-between; gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: white;
    border: 2px solid #D4C9A8;
    border-radius: 0.75rem;
    font-weight: 600;
    color: var(--green-dark);
    transition: all 0.2s;
  }
  .topic-chip:hover { border-color: var(--green-light); transform: translateX(4px); }
  .topic-chip .count {
    background: var(--green-dark);
    color: var(--cream);
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
  }
  
  /* Vinyl decoration */
  .vinyl-accent {
    background: radial-gradient(circle at center, #1B4332 0%, #2D6A4F 40%, #40916C 70%, #52B788 100%);
    border-radius: 50%;
    position: relative;
  }
  .vinyl-accent::before {
    content: '';
    position: absolute;
    inset: 35%;
    background: var(--cream);
    border-radius: 50%;
  }
  .vinyl-accent::after {
    content: '';
    position: absolute;
    inset: 42%;
    background: var(--green-dark);
    border-radius: 50%;
  }
  
  /* Progress bar */
  .progress-fill {
    background: linear-gradient(90deg, #1B4332 0%, #40916C 50%, #52B788 100%);
  }
</style>
</head>
