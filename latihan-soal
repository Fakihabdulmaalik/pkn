  {id:31,type:'esai',topic:'Dinamika Penjajahan',q:'Jelaskan kondisi kehidupan dan penderitaan bangsa Indonesia pada masa penjajahan!',ans:'Rakyat miskin, bodoh, hak asasi dirampas, kerja paksa (romusha), pajak tinggi, diskriminasi.',exp:'Fokus pada aspek ekonomi, sosial, dan HAM.'},
  {id:32,type:'esai',topic:'Konsensus Dasar',q:'Sebutkan dan jelaskan singkat 4 konsensus dasar berbangsa dan bernegara!',ans:'1. Pancasila (Dasar Negara), 2. UUD 1945 (Konstitusi), 3. NKRI (Bentuk Negara), 4. Bhinneka Tunggal Ika (Semboyan).',exp:'Harus menyebutkan keempatnya.'},
  {id:33,type:'esai',topic:'Konsensus Dasar',q:'Jelaskan hubungan kedudukan antara Pancasila dan UUD 1945!',ans:'Pancasila adalah sumber dari segala sumber hukum termasuk UUD 1945. UUD 1945 adalah penjabaran nilai-nilai Pancasila dalam bentuk hukum dasar tertulis.',exp:'Hubungan hierarkis: Pancasila di atas UUD 1945.'},
  {id:34,type:'esai',topic:'Konsensus Dasar',q:'(English) Explain why Bhinneka Tunggal Ika is important for Indonesia!',ans:'Because Indonesia has many diversities (ethnic, religion, language, etc). The motto unites us despite differences and maintains national integrity.',exp:'Menjelaskan fungsi pemersatu dalam keberagaman.'},
  {id:35,type:'esai',topic:'Sistem Pemerintahan',q:'Bandingkan karakteristik sistem politik Masa Orde Baru dan Masa Reformasi!',ans:'Orba: Sentralistik, otoriter, dwifungsi ABRI, pembatasan pers. Reformasi: Demokratis, desentralisasi (otda), supremasi hukum, HAM dihormati, kebebasan pers.',exp:'Perbedaan mendasar pada kebebasan dan struktur kekuasaan.'}
];

// ============ STATE ============
let currentIdx = 0, answers = {}, selfMarks = {};
document.getElementById('totalNum').textContent = questions.length;

function startQuiz(){document.getElementById('startScreen').classList.add('hidden');document.getElementById('quizScreen').classList.remove('hidden');render();renderGrid();}
function render(){
  const q=questions[currentIdx],area=document.getElementById('questionContent');
  document.getElementById('currentNum').textContent=currentIdx+1;
  document.getElementById('topicBadge').textContent=q.topic;
  document.getElementById('typeBadge').textContent=q.type==='pg'?'Pilihan Ganda':q.type==='isian'?'Isian Singkat':'Uraian';
  document.getElementById('progressBar').style.width=`${((currentIdx+1)/questions.length)*100}%`;
  document.getElementById('prevBtn').disabled=currentIdx===0;
  if(currentIdx===questions.length-1){document.getElementById('nextBtn').classList.add('hidden');document.getElementById('submitBtn').classList.remove('hidden');}
  else{document.getElementById('nextBtn').classList.remove('hidden');document.getElementById('submitBtn').classList.add('hidden');}
  let html=`<div class="fade-in"><h2 class="text-xl md:text-2xl font-bold text-[#1B4332] mb-6">${currentIdx+1}. ${q.q}</h2>`;
  if(q.type==='pg'){html+=`<div class="grid gap-3">`;q.opts.forEach((opt,i)=>{const selected=answers[q.id]===opt?'selected':'';html+=`<div class="option-card p-4 rounded-xl flex items-center gap-3 ${selected}" onclick="selectOption(${q.id},'${opt.replace(/'/g,"\\'")}',this)"><div class="w-8 h-8 rounded-full border-2 border-[#D4C9A8] flex items-center justify-center font-bold text-[#2D6A4F] text-sm">${String.fromCharCode(65+i)}</div><span class="text-[#1B4332]">${opt}</span></div>`;});html+=`</div>`;}
  else{const val=answers[q.id]||'',placeholder=q.type==='esai'?'Tuliskan jawaban uraian Anda...':'Ketik jawaban singkat...',rows=q.type==='esai'?6:1;html+=`<textarea oninput="answers[${q.id}]=this.value;updateGrid();" rows="${rows}" class="w-full p-4 border-2 border-[#D4C9A8] rounded-xl focus:border-[#40916C] focus:ring-4 focus:ring-[#74C69D]/30 outline-none transition text-lg text-[#1B4332] bg-white" placeholder="${placeholder}">${val}</textarea>${q.type==='isian'?'<p class="text-xs text-[#2D6A4F] mt-2">*Jawaban tidak peka huruf besar/kecil.</p>':''}`;}
  html+=`</div>`;area.innerHTML=html;}
function selectOption(qId,value,el){answers[qId]=value;document.querySelectorAll('.option-card').forEach(c=>c.classList.remove('selected'));el.classList.add('selected');updateGrid();}
function changeQ(dir){currentIdx+=dir;if(currentIdx<0)currentIdx=0;if(currentIdx>=questions.length)currentIdx=questions.length-1;render();renderGrid();window.scrollTo({top:0,behavior:'smooth'});}
function renderGrid(){const grid=document.getElementById('qGrid');grid.innerHTML='';questions.forEach((q,i)=>{const btn=document.createElement('button');btn.className=`q-btn w-full aspect-square rounded-lg border-2 border-[#D4C9A8] font-bold text-sm flex items-center justify-center bg-white text-[#1B4332] ${answers[q.id]!==undefined&&answers[q.id]!==''?'answered':''} ${i===currentIdx?'current':''}`;btn.textContent=i+1;btn.onclick=()=>{currentIdx=i;render();renderGrid();};grid.appendChild(btn);});document.getElementById('answeredCount').textContent=questions.filter(q=>answers[q.id]!==undefined&&answers[q.id]!=='').length;}
function updateGrid(){renderGrid();}
function submitQuiz(){const unanswered=questions.filter(q=>answers[q.id]===undefined||answers[q.id]==='').length;if(unanswered>0&&!confirm(`Masih ada ${unanswered} soal belum dijawab. Tetap lanjut?`))return;if(!confirm('Lihat kunci jawaban dan mulai penilaian pribadi?'))return;document.getElementById('quizScreen').classList.add('hidden');document.getElementById('resultScreen').classList.remove('hidden');renderReview();window.scrollTo({top:0,behavior:'smooth'});}
function renderReview(){const area=document.getElementById('reviewArea');area.innerHTML='';questions.forEach((q,idx)=>{const userAns=answers[q.id]||'<em class="text-gray-400">Tidak dijawab</em>',keyAns=Array.isArray(q.ans)?q.ans[0]:q.ans;const card=document.createElement('div');card.className='border-2 border-[#D4C9A8] rounded-2xl p-5 bg-white';card.innerHTML=`<div class="flex items-start justify-between gap-3 mb-3 flex-wrap"><div class="flex items-center gap-2 flex-wrap"><span class="px-3 py-1 bg-[#1B4332] text-[#F5F1E8] text-xs font-bold rounded-full">Soal ${idx+1}</span><span class="px-3 py-1 bg-[#D4C9A8] text-[#1B4332] text-xs font-bold rounded-full uppercase">${q.topic}</span><span class="px-3 py-1 bg-[#74C69D] text-[#1B4332] text-xs font-bold rounded-full uppercase">${q.type==='pg'?'PG':q.type==='isian'?'Isian':'Esai'}</span></div></div><p class="text-[#1B4332] font-semibold mb-3">${q.q}</p><div class="grid md:grid-cols-2 gap-3 mb-3"><div class="p-3 bg-[#E8F5E9] border-l-4 border-[#40916C] rounded-r-lg"><div class="text-xs text-[#2D6A4F] font-bold mb-1">JAWABAN ANDA</div><div class="text-[#1B4332] text-sm">${userAns}</div></div><div class="p-3 bg-[#FFF8E1] border-l-4 border-[#D4AF37] rounded-r-lg"><div class="text-xs text-[#8B6914] font-bold mb-1">🔑 KUNCI JAWABAN</div><div class="text-[#1B4332] text-sm font-semibold">${keyAns}</div></div></div><div class="p-3 bg-[#F5F1E8] border-l-4 border-[#2D6A4F] rounded-r-lg mb-4"><div class="text-xs text-[#2D6A4F] font-bold mb-1">💡 PEMBAHASAN</div><div class="text-[#1B4332] text-sm">${q.exp}</div></div><div class="flex gap-2"><button onclick="markSelf(${q.id},'correct',this)" class="self-btn flex-1 py-3 bg-white border-2 border-[#40916C] text-[#2D6A4F] rounded-xl font-bold hover:bg-[#E8F5E9] transition">✓ Benar</button><button onclick="markSelf(${q.id},'wrong',this)" class="self-btn flex-1 py-3 bg-white border-2 border-[#B91C1C] text-[#B91C1C] rounded-xl font-bold hover:bg-red-50 transition">✗ Salah</button></div>`;area.appendChild(card);});updateScore();}
function markSelf(qId,mark,btn){selfMarks[qId]=mark;const parent=btn.parentElement;parent.querySelectorAll('.self-btn').forEach(b=>b.classList.remove('marked-correct','marked-wrong'));btn.classList.add(mark==='correct'?'marked-correct':'marked-wrong');updateScore();}
function updateScore(){const marked=Object.keys(selfMarks).length,correct=Object.values(selfMarks).filter(v=>v==='correct').length,score=marked>0?Math.round((correct/marked)*100):0;document.getElementById('finalScore').textContent=score;let msg='';if(marked<questions.length)msg=`Tandai semua soal untuk skor final (${marked}/${questions.length} sudah dinilai)`;else if(score>=90)msg='🌟 Luar Biasa! Pemahamanmu sangat baik!';else if(score>=75)msg='👍 Bagus! Terus tingkatkan!';else if(score>=60)msg='💪 Cukup baik, pelajari lagi materi yang salah.';else msg='📚 Perlu belajar lebih giat. Semangat!';document.getElementById('scoreMessage').textContent=msg;renderBreakdown();}
function renderBreakdown(){const topics={};questions.forEach(q=>{if(!topics[q.topic])topics[q.topic]={total:0,correct:0,marked:0};topics[q.topic].total++;if(selfMarks[q.id]!==undefined){topics[q.topic].marked++;if(selfMarks[q.id]==='correct')topics[q.topic].correct++;}});const area=document.getElementById('topicBreakdown');area.innerHTML='';Object.entries(topics).forEach(([topic,data])=>{const pct=data.marked>0?Math.round((data.correct/data.marked)*100):0,barWidth=data.marked>0?(data.correct/data.marked)*100:0;const row=document.createElement('div');row.className='bg-white p-4 rounded-xl border border-[#D4C9A8]';row.innerHTML=`<div class="flex justify-between items-center mb-2"><div class="font-bold text-[#1B4332]">${topic}</div><div class="text-sm font-semibold text-[#2D6A4F]">${data.correct}/${data.marked} (${pct}%)</div></div><div class="h-2 bg-[#D4C9A8] rounded-full overflow-hidden"><div class="h-full progress-fill transition-all duration-500" style="width:${barWidth}%"></div></div>`;area.appendChild(row);});}
</script>
</body>
</html>
